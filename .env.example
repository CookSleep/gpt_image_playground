DATABASE_URL=postgres://user:password@postgres-host:5432/minimal_image_site
SESSION_SECRET=please-change-to-a-long-random-string
SUB2API_BASE_URL=http://host.docker.internal:8080
SUB2API_TIMEOUT_MS=30000
# 默认留空时使用 SUB2API_BASE_URL/v1 作为 OpenAI-compatible 网关。
OPENAI_BASE_URL=
OPENAI_API_KEY=
DEFAULT_IMAGE_MODEL=gpt-image-2
DEFAULT_TEXT_MODEL=gpt-5.5
OPENAI_TEXT_TIMEOUT_MS=120000
OPENAI_IMAGE_PARTIAL_IMAGES=2
OPENAI_IMAGE_TIMEOUT_MS=600000
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=minimal-images
S3_ACCESS_KEY_ID=xxxx
S3_SECRET_ACCESS_KEY=xxxx
S3_FORCE_PATH_STYLE=true
FRONTEND_PORT=8088
