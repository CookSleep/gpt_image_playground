server:
  host: 0.0.0.0
  port: 8080
  environment: development        # development | production
  base_url: http://localhost:8080 # 后端对外基础地址，OIDC 回调拼接用
  frontend_url: http://localhost:5173 # 登录完成后回跳的前端入口
  cors_origins:
    - http://localhost:5173
    - http://localhost:3000

log:
  level: info                      # debug | info | warn | error
  file: ""                        # 留空仅写 stdout；Docker 落盘可填 /app/logs/backend.log
  max_size_mb: 100                # 单个日志文件达到该大小后轮转
  max_backups: 10                 # 最多保留的旧日志文件数量
  max_age_days: 30                # 旧日志最长保留天数

database:
  host: localhost
  port: 5432
  user: postgres
  password: password
  name: gpt_image_playground
  ssl_mode: disable
  max_open_conns: 25
  max_idle_conns: 5
  max_lifetime_seconds: 300

jwt:
  secret_key: change-me-to-a-long-random-secret
  issuer: gpt-image-backend
  expire_hours: 24
  refresh_hours: 168              # 7 天

# 管理员身份配置：命中 emails 的账号会在 /auth/user 返回 is_admin=true，
# 前端凭此开放管理员入口，后端也会用同一配置校验管理员接口。留空表示无管理员。
admin:
  emails: []
    # - admin@example.com

# 模型展示白名单。后台只返回“当前 API Key 可用模型”和对应列表的交集。
# 某个列表留空时，该场景不限制模型。
model_whitelist:
  image: []
    # - gpt-image-2
    # - fal-ai/flux/dev
  agent: []
    # - gpt-5.2

# 生图相关上游地址。base_url 为空时使用对应 OIDC provider 的资源地址。
# 支持 https://api.example.com、http://10.0.0.5:8080，也支持直接填写 10.0.0.5:8080（按 HTTP 处理）。
# 各组 API 的接口路径固定，详见 backend/README.md，不在配置文件中覆盖。
upstreams:
  image_api:
    base_url: ""
    # OpenAI 平台分组启用 Codex CLI 兼容模式时，Images Generations/Edits 的 n > 1 会由后端拆分；Responses 不拆分。
    codex_cli: false
  resource_api:
    base_url: ""
  composite_api:
    base_url: ""
  file_api:
    base_url: ""

# 账户余额与素材库管理使用该内部 RPC；app 需要开放对应的 GetBalance/素材权限。
# 未配置时余额显示为不可用；不使用余额和素材库时可整体留空。
inner_api_rpc:
  target: ""                    # 例如 ip://10.0.0.5:9100
  app_token: ""                 # 内部 API App 页面创建后仅展示一次
  timeout_seconds: 30

# Composite 编辑参考图使用 File API 临时上传。
# 填写创建开发者密钥时一次性展示的完整密钥，不能填写 key_prefix。
file_api:
  developer_key: ""
  timeout_seconds: 600

oidc:
  providers:
    # 通用 OIDC 提供商（标准 OIDC discovery 协议即可）
    - name: corp-sso
      display_name: 企业单点登录
      issuer_url: https://your-oidc-provider.example.com
      # 资源上游与 OIDC issuer 不同或需要内网访问时填写；支持域名和 IP:端口。
      resource_base_url: ""
      client_id: your-client-id
      client_secret: your-client-secret
      redirect_uri: http://localhost:8080/auth/callback/corp-sso
      scopes:
        - openid
        - profile
        - email
