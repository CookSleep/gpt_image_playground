{
  "customProviders": [
    {
      "id": "custom-apimart",
      "name": "APIMart",
      "submit": {
        "path": "images/generations",
        "method": "POST",
        "contentType": "json",
        "body": {
          "model": "$profile.model",
          "prompt": "$prompt",
          "size": "$params.size",
          "quality": "$params.quality",
          "output_format": "$params.output_format",
          "output_compression": "$params.output_compression",
          "moderation": "$params.moderation",
          "n": "$params.n",
          "background": "$params.background",
          "image_urls": "$inputImages.dataUrls",
          "mask_url": "$mask.dataUrl"
        },
        "taskIdPath": "data.0.task_id"
      },
      "poll": {
        "path": "tasks/{task_id}",
        "method": "GET",
        "intervalSeconds": 5,
        "statusPath": "data.status",
        "successValues": ["completed"],
        "failureValues": ["failed"],
        "errorPath": "data.error.message",
        "result": {
          "imageUrlPaths": ["data.result.images.*.url.*"],
          "b64JsonPaths": []
        }
      }
    },
    {
      "id": "custom-apixo",
      "name": "APIXO AI",
      "submit": {
        "path": "generateTask/{model}",
        "method": "POST",
        "contentType": "json",
        "omitValues": { "$params.quality": ["auto"] },
        "body": {
          "request_type": "async",
          "input": {
            "mode": "$mode",
            "prompt": "$prompt",
            "size": "$size.pixels",
            "quality": "$params.quality",
            "complexity": "$params.complexity",
            "output_format": "$params.output_format",
            "frame_count": "$params.frame_count",
            "frame_duration_ms": "$params.frame_duration_ms",
            "image_urls": "$inputImages.urls"
          }
        },
        "taskIdPath": "data.taskId"
      },
      "poll": {
        "path": "statusTask/{model}",
        "method": "GET",
        "query": {
          "taskId": "{task_id}"
        },
        "intervalSeconds": 5,
        "statusPath": "data.state",
        "successValues": ["success"],
        "failureValues": ["failed"],
        "errorPath": "data.failMsg",
        "result": {
          "imageUrlPaths": ["data.resultJson.resultUrls.*"],
          "b64JsonPaths": []
        }
      },
      "modelOverrides": [
        {
          "models": ["seedream-5-5"],
          "submit": {
            "path": "generateTask/{model}",
            "method": "POST",
            "contentType": "json",
            "body": {
              "request_type": "async",
              "input": {
                "mode": "$mode",
                "prompt": "$prompt",
                "size": "$size.pixels",
                "aspect_ratio": "$params.aspect_ratio",
                "resolution": "$resolution.lower",
                "background": "$params.background",
                "output_format": "$params.output_format",
                "watermark": "$params.watermark",
                "image_urls": "$inputImages.urls"
              }
            },
            "taskIdPath": "data.taskId"
          }
        }
      ]
    }
  ],
